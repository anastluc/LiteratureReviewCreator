# LLM (default: OpenRouter). Get a key at https://openrouter.ai/keys
OPENROUTER_API_KEY=
# Model for every LLM task (any OpenRouter model id)
LITKB_MODEL=google/gemini-4-hydrogen
# Optional per-role overrides: synthesis = reports + answers, fast = RQ drafting + cluster labels
# LITKB_MODEL_SYNTHESIS=
# LITKB_MODEL_FAST=
# Optional: another provider (openrouter | anthropic | openai_compatible); set LITKB_MODEL to match
# LITKB_PROVIDER=
# ANTHROPIC_API_KEY=
# OPENAI_API_KEY=
# Contact email sent to Unpaywall (required) and OpenAlex (polite pool)
UNPAYWALL_EMAIL=
OPENALEX_EMAIL=
# Optional: higher Semantic Scholar rate limits
SEMANTIC_SCHOLAR_API_KEY=
# University proxy prefix, e.g. https://ezproxy.myuni.edu/login?url=
EZPROXY_PREFIX=
